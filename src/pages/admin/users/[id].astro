---
import Layout from '@/layouts/Layout.astro';
import { localData } from '@/lib/local-data';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const users = await localData.getUsers();
  return users.map((user) => ({
    params: { id: user.id.toString() },
  }));
}

const { id } = Astro.params;
const user = await localData.getUser(parseInt(id!));
---

<Layout title={`${user.name} - Admin`}>
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">{user.name}</h1>
        <p class="text-gray-600 mt-1">ID: {user.id}</p>
      </div>
      <a
        href={`${base}admin/users`}
        class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium"
      >
        ← Volver a usuarios
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Main Info -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Basic Info -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Información Básica</h2>
          <dl class="space-y-3">
            <div>
              <dt class="text-sm font-medium text-gray-600">Nombre completo</dt>
              <dd class="text-sm text-gray-900 mt-1">{user.name}</dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-600">Email</dt>
              <dd class="text-sm text-gray-900 mt-1">
                {user.email ? (
                  <a href={`mailto:${user.email}`} class="text-blue-600 hover:underline">
                    {user.email}
                  </a>
                ) : 'N/A'}
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-600">Usuario</dt>
              <dd class="text-sm text-gray-900 mt-1">{user.slug}</dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-600">Roles</dt>
              <dd class="text-sm text-gray-900 mt-1">
                <div class="flex flex-wrap gap-2">
                  {user.roles && user.roles.length > 0 ? (
                    user.roles.map((role: string) => (
                      <span class="px-2 py-1 text-xs font-medium bg-indigo-100 text-indigo-800 rounded">
                        {role}
                      </span>
                    ))
                  ) : (
                    <span class="text-gray-400 italic">Sin roles asignados</span>
                  )}
                </div>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-600">Fecha de registro</dt>
              <dd class="text-sm text-gray-900 mt-1">
                {user.registered_date ? new Date(user.registered_date).toLocaleString('es-AR') : 'N/A'}
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-600">URL</dt>
              <dd class="text-sm text-gray-900 mt-1">
                {user.link ? (
                  <a href={user.link} target="_blank" class="text-blue-600 hover:underline break-all">
                    {user.link}
                  </a>
                ) : 'N/A'}
              </dd>
            </div>
          </dl>
        </div>

        <!-- Description -->
        {user.description && (
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4">Descripción</h2>
            <p class="text-gray-700">{user.description}</p>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Avatar -->
        {user.avatar_urls && (
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4">Avatar</h2>
            <img
              src={user.avatar_urls['96'] || user.avatar_urls['48'] || user.avatar_urls['24']}
              alt={user.name}
              class="w-24 h-24 rounded-full mx-auto"
            />
          </div>
        )}

        <!-- Meta Info -->
        {user.meta && (
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4">Meta Info</h2>
            <dl class="space-y-2 text-sm">
              {user.meta.first_name && (
                <div>
                  <dt class="text-gray-600">Nombre</dt>
                  <dd class="text-gray-900">{user.meta.first_name}</dd>
                </div>
              )}
              {user.meta.last_name && (
                <div>
                  <dt class="text-gray-600">Apellido</dt>
                  <dd class="text-gray-900">{user.meta.last_name}</dd>
                </div>
              )}
              {user.meta.nickname && (
                <div>
                  <dt class="text-gray-600">Apodo</dt>
                  <dd class="text-gray-900">{user.meta.nickname}</dd>
                </div>
              )}
            </dl>
          </div>
        )}

        <!-- Metadata -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Metadata Completa</h2>
          <details class="text-sm">
            <summary class="cursor-pointer font-medium text-gray-700 hover:text-gray-900">Ver metadata</summary>
            <pre class="mt-2 p-2 bg-gray-50 rounded text-xs overflow-auto max-h-96">{JSON.stringify(user.meta, null, 2)}</pre>
          </details>
        </div>
      </div>
    </div>
  </div>
</Layout>
