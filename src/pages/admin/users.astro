---
import Layout from '@/layouts/Layout.astro';
import { localData } from '@/lib/local-data';

const base = import.meta.env.BASE_URL;
const users = await localData.getUsers();
---

<Layout title="Usuarios - Admin - RE/MAX Titanium">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Usuarios</h1>
        <p class="text-gray-600 mt-1">Gestiona todos los usuarios</p>
      </div>
      <a
        href={`${base}admin`}
        class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium"
      >
        ← Volver al panel
      </a>
    </div>

    <!-- Stats -->
    <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-4">
      <p class="text-indigo-900 font-semibold">Total: {users.length} usuario(s)</p>
    </div>

    <!-- Users List -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nombre</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Usuario</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Roles</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Registrado</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            {users.map((user) => (
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  {user.id}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  {user.name}
                </td>
                <td class="px-6 py-4 text-sm text-gray-600">
                  {user.email ? (
                    <a href={`mailto:${user.email}`} class="text-blue-600 hover:underline">
                      {user.email}
                    </a>
                  ) : (
                    <span class="text-gray-400 italic">N/A</span>
                  )}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                  {user.slug}
                </td>
                <td class="px-6 py-4 text-sm text-gray-600">
                  <div class="flex flex-wrap gap-1">
                    {user.roles && user.roles.length > 0 ? (
                      user.roles.map((role: string) => (
                        <span class="px-2 py-1 text-xs font-medium bg-indigo-100 text-indigo-800 rounded">
                          {role}
                        </span>
                      ))
                    ) : (
                      <span class="text-gray-400 italic">Sin rol</span>
                    )}
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                  {user.registered_date ? new Date(user.registered_date).toLocaleDateString('es-AR') : 'N/A'}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <a
                    href={`${base}admin/users/${user.id}`}
                    class="text-indigo-600 hover:text-indigo-800"
                  >
                    Ver detalles
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>
