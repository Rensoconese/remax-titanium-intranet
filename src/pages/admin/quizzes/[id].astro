---
import Layout from '@/layouts/Layout.astro';
import { localData } from '@/lib/local-data';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const quizzes = await localData.getQuizzes();
  return quizzes.map((quiz) => ({
    params: { id: quiz.id.toString() },
  }));
}

const { id } = Astro.params;
const quiz = await localData.getQuiz(parseInt(id!));

// Get course info
let courseName = 'N/A';
if (quiz.course) {
  try {
    const course = await localData.getCourse(quiz.course);
    courseName = course.title.rendered;
  } catch (e) {
    courseName = `ID: ${quiz.course}`;
  }
}
---

<Layout title={`${quiz.title.rendered} - Admin`}>
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">{quiz.title.rendered}</h1>
        <p class="text-gray-600 mt-1">ID: {quiz.id}</p>
      </div>
      <a
        href={`${base}admin/quizzes`}
        class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium"
      >
        ← Volver a quizzes
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Main Info -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Basic Info -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Información Básica</h2>
          <dl class="space-y-3">
            <div>
              <dt class="text-sm font-medium text-gray-600">Curso</dt>
              <dd class="text-sm text-gray-900 mt-1">
                {quiz.course ? (
                  <a href={`${base}admin/courses/${quiz.course}`} class="text-blue-600 hover:underline">
                    {courseName}
                  </a>
                ) : 'N/A'}
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-600">Slug</dt>
              <dd class="text-sm text-gray-900 mt-1">{quiz.slug}</dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-600">Estado</dt>
              <dd class="text-sm text-gray-900 mt-1">
                <span class={`px-2 py-1 text-xs font-medium rounded-full ${
                  quiz.status === 'publish' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'
                }`}>
                  {quiz.status === 'publish' ? 'Publicado' : quiz.status}
                </span>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-600">Fecha de creación</dt>
              <dd class="text-sm text-gray-900 mt-1">{new Date(quiz.date).toLocaleString('es-AR')}</dd>
            </div>
          </dl>
        </div>

        <!-- Content -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Contenido</h2>
          {quiz.content.rendered ? (
            <div class="prose max-w-none" set:html={quiz.content.rendered} />
          ) : (
            <p class="text-gray-600 italic">Sin contenido</p>
          )}
        </div>

        <!-- Quiz Settings -->
        {quiz.quiz_materials && (
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4">Materiales del Quiz</h2>
            <div class="prose max-w-none" set:html={quiz.quiz_materials} />
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Actions -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Acciones</h2>
          <div class="space-y-2">
            {quiz.course && (
              <a
                href={`${base}admin/courses/${quiz.course}`}
                class="block w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-center font-medium"
              >
                Ver curso
              </a>
            )}
          </div>
        </div>

        <!-- Metadata -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Metadata</h2>
          <details class="text-sm">
            <summary class="cursor-pointer font-medium text-gray-700 hover:text-gray-900">Ver meta</summary>
            <pre class="mt-2 p-2 bg-gray-50 rounded text-xs overflow-auto max-h-96">{JSON.stringify(quiz.meta, null, 2)}</pre>
          </details>
        </div>
      </div>
    </div>
  </div>
</Layout>
