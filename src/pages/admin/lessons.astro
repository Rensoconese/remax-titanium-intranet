---
import Layout from '@/layouts/Layout.astro';
import { localData } from '@/lib/local-data';

const base = import.meta.env.BASE_URL;
const lessons = await localData.getLessons();
const courses = await localData.getCourses();

// Create a map of course IDs to course names
const courseMap = new Map(courses.map(c => [c.id, c.title.rendered]));
---

<Layout title="Lecciones - Admin - RE/MAX Titanium">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Lecciones</h1>
        <p class="text-gray-600 mt-1">Gestiona todas las lecciones</p>
      </div>
      <a
        href={`${base}admin`}
        class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium"
      >
        ← Volver al panel
      </a>
    </div>

    <!-- Stats -->
    <div class="bg-green-50 border border-green-200 rounded-lg p-4">
      <p class="text-green-900 font-semibold">Total: {lessons.length} lección(es)</p>
    </div>

    <!-- Lessons List -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Título</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Curso</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Video</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            {lessons.map((lesson) => (
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  {lesson.id}
                </td>
                <td class="px-6 py-4 text-sm text-gray-900">
                  <div class="max-w-xs truncate">{lesson.title.rendered}</div>
                </td>
                <td class="px-6 py-4 text-sm text-gray-600">
                  <div class="max-w-xs truncate">
                    {lesson.course ? courseMap.get(lesson.course) || `ID: ${lesson.course}` : 'N/A'}
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class={`px-2 py-1 text-xs font-medium rounded-full ${
                    lesson.status === 'publish' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'
                  }`}>
                    {lesson.status === 'publish' ? 'Publicado' : lesson.status}
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                  {lesson.lesson_video_enabled ? (
                    <span class="text-green-600">✓ Sí</span>
                  ) : (
                    <span class="text-gray-400">No</span>
                  )}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                  {new Date(lesson.date).toLocaleDateString('es-AR')}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                  <a
                    href={`${base}lessons/${lesson.id}`}
                    class="text-blue-600 hover:text-blue-800"
                    target="_blank"
                  >
                    Ver
                  </a>
                  <a
                    href={`${base}admin/lessons/${lesson.id}`}
                    class="text-indigo-600 hover:text-indigo-800"
                  >
                    Detalles
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>
