---
import Layout from '@/layouts/Layout.astro';
import { localData } from '@/lib/local-data';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const lessons = await localData.getLessons();
  return lessons.map((lesson) => ({
    params: { id: lesson.id.toString() },
  }));
}

const { id } = Astro.params;
const lesson = await localData.getLesson(parseInt(id!));
const topics = await localData.getTopics(lesson.id);

// Get course info
let courseName = 'N/A';
if (lesson.course) {
  try {
    const course = await localData.getCourse(lesson.course);
    courseName = course.title.rendered;
  } catch (e) {
    courseName = `ID: ${lesson.course}`;
  }
}
---

<Layout title={`${lesson.title.rendered} - Admin`}>
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">{lesson.title.rendered}</h1>
        <p class="text-gray-600 mt-1">ID: {lesson.id}</p>
      </div>
      <a
        href={`${base}admin/lessons`}
        class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-medium"
      >
        ← Volver a lecciones
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Main Info -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Basic Info -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Información Básica</h2>
          <dl class="space-y-3">
            <div>
              <dt class="text-sm font-medium text-gray-600">Curso</dt>
              <dd class="text-sm text-gray-900 mt-1">
                {lesson.course ? (
                  <a href={`${base}admin/courses/${lesson.course}`} class="text-blue-600 hover:underline">
                    {courseName}
                  </a>
                ) : 'N/A'}
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-600">Slug</dt>
              <dd class="text-sm text-gray-900 mt-1">{lesson.slug}</dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-600">Estado</dt>
              <dd class="text-sm text-gray-900 mt-1">
                <span class={`px-2 py-1 text-xs font-medium rounded-full ${
                  lesson.status === 'publish' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'
                }`}>
                  {lesson.status === 'publish' ? 'Publicado' : lesson.status}
                </span>
              </dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-600">Video habilitado</dt>
              <dd class="text-sm text-gray-900 mt-1">{lesson.lesson_video_enabled ? 'Sí' : 'No'}</dd>
            </div>
            {lesson.lesson_video_enabled && lesson.lesson_video_url && (
              <div>
                <dt class="text-sm font-medium text-gray-600">URL del video</dt>
                <dd class="text-sm text-blue-600 mt-1">
                  <a href={lesson.lesson_video_url} target="_blank" class="hover:underline break-all">
                    {lesson.lesson_video_url}
                  </a>
                </dd>
              </div>
            )}
            <div>
              <dt class="text-sm font-medium text-gray-600">Asignación</dt>
              <dd class="text-sm text-gray-900 mt-1">{lesson.lesson_assignment_upload ? 'Sí' : 'No'}</dd>
            </div>
            <div>
              <dt class="text-sm font-medium text-gray-600">Fecha de creación</dt>
              <dd class="text-sm text-gray-900 mt-1">{new Date(lesson.date).toLocaleString('es-AR')}</dd>
            </div>
          </dl>
        </div>

        <!-- Content -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Contenido</h2>
          <div class="prose max-w-none" set:html={lesson.content.rendered} />
        </div>

        <!-- Materials -->
        {lesson.lesson_materials && (
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4">Materiales</h2>
            <div class="prose max-w-none" set:html={lesson.lesson_materials} />
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Topics -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Tópicos</h2>
          <div class="flex items-center justify-center p-6 bg-purple-50 rounded-lg">
            <span class="text-4xl font-bold text-purple-600">{topics.length}</span>
          </div>
        </div>

        <!-- Actions -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Acciones</h2>
          <div class="space-y-2">
            <a
              href={`${base}lessons/${lesson.id}`}
              target="_blank"
              class="block w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-center font-medium"
            >
              Ver en el sitio
            </a>
            {lesson.course && (
              <a
                href={`${base}admin/courses/${lesson.course}`}
                class="block w-full px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors text-center font-medium"
              >
                Ver curso
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Topics List -->
    {topics.length > 0 && (
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <h2 class="text-xl font-bold text-gray-900 mb-4">Tópicos de esta Lección</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {topics.map((topic) => (
            <div class="border border-gray-200 rounded-lg p-4 hover:bg-gray-50">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <h3 class="font-semibold text-gray-900">{topic.title.rendered}</h3>
                  <p class="text-sm text-gray-600 mt-1">ID: {topic.id}</p>
                </div>
                <a
                  href={`${base}admin/topics/${topic.id}`}
                  class="text-blue-600 hover:text-blue-800 text-sm font-medium"
                >
                  Ver →
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>
