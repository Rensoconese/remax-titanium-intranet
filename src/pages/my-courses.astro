---
import Layout from '@/layouts/Layout.astro';
import { localData } from '@/lib/local-data';

const base = import.meta.env.BASE_URL;
const courses = await localData.getCourses();
---

<Layout title="Mis Cursos - RE/MAX Titanium">
  <div class="space-y-6">
    <!-- Header -->
    <div class="bg-gradient-to-r from-primary-600 to-blue-700 rounded-lg shadow-lg p-8 text-white">
      <h1 class="text-4xl font-bold mb-2">Mis Cursos</h1>
      <p class="text-primary-100">Continúa tu aprendizaje donde lo dejaste</p>
    </div>

    <!-- Info Box -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
      <div class="flex items-start">
        <svg class="w-5 h-5 text-blue-600 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
        </svg>
        <div>
          <p class="text-sm text-blue-900 font-medium">
            Tu progreso se guarda automáticamente en tu navegador
          </p>
          <p class="text-xs text-blue-700 mt-1">
            Podrás ver aquí todos los cursos en los que estás inscrito y tu progreso en cada uno.
          </p>
        </div>
      </div>
    </div>

    <!-- Courses Grid -->
    {courses.length > 0 ? (
      <div class="space-y-8">
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Todos los Cursos Disponibles</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {courses.map((course) => {
              // Calculate mock progress (in a real app, this would come from localStorage or a backend)
              const progress = 0; // Default to 0% for now

              return (
                <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow">
                  <div class="p-6">
                    <div class="flex items-start justify-between mb-3">
                      <h3 class="text-lg font-semibold text-gray-900 flex-1">
                        {course.title.rendered}
                      </h3>
                      {course.course_price_type && (
                        <span class={`ml-2 px-2 py-1 text-xs font-medium rounded-full flex-shrink-0 ${
                          course.course_price_type === 'free' || course.course_price_type === 'open'
                            ? 'bg-green-100 text-green-800'
                            : 'bg-blue-100 text-blue-800'
                        }`}>
                          {course.course_price_type === 'free' || course.course_price_type === 'open' ? 'Gratuito' : 'Premium'}
                        </span>
                      )}
                    </div>

                    {course.excerpt && course.excerpt.rendered && (
                      <div
                        class="text-gray-600 text-sm mb-4 line-clamp-2"
                        set:html={course.excerpt.rendered}
                      />
                    )}

                    <!-- Progress Bar -->
                    <div class="mb-4">
                      <div class="flex items-center justify-between text-sm mb-1">
                        <span class="text-gray-600">Progreso</span>
                        <span class="font-semibold text-gray-900">{progress}%</span>
                      </div>
                      <div class="w-full bg-gray-200 rounded-full h-2">
                        <div
                          class="bg-primary-600 h-2 rounded-full transition-all duration-300"
                          style={`width: ${progress}%`}
                        />
                      </div>
                    </div>

                    <!-- Action Button -->
                    <a
                      href={`${base}courses/${course.id}`}
                      class="block w-full text-center px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white font-medium rounded-lg transition-colors"
                    >
                      {progress > 0 ? 'Continuar curso' : 'Comenzar curso'}
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    ) : (
      <div class="bg-yellow-50 border border-yellow-200 text-yellow-700 px-6 py-8 rounded-lg text-center">
        <svg class="w-16 h-16 text-yellow-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
        <p class="font-medium text-lg">No hay cursos disponibles</p>
        <p class="text-sm mt-2">Los cursos aparecerán aquí cuando se agreguen al sistema.</p>
      </div>
    )}
  </div>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
