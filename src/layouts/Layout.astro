---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Intranet de cursos RE/MAX Titanium' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-gray-50">
    <header class="bg-white shadow-sm border-b border-gray-200">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <div class="flex items-center">
            <a href={base} class="text-xl font-bold text-primary-600">
              RE/MAX Titanium
            </a>
          </div>
          <div class="flex items-center space-x-4">
            <a href={base} class="text-gray-700 hover:text-primary-600 px-3 py-2 rounded-md text-sm font-medium">
              Cursos
            </a>
            <a href={`${base}my-courses`} class="text-gray-700 hover:text-primary-600 px-3 py-2 rounded-md text-sm font-medium">
              Mis Cursos
            </a>
            <a href={`${base}profile`} class="text-gray-700 hover:text-primary-600 px-3 py-2 rounded-md text-sm font-medium">
              Mi Perfil
            </a>
          </div>
        </div>
      </nav>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <footer class="bg-white border-t border-gray-200 mt-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <p class="text-center text-gray-600 text-sm">
          © {new Date().getFullYear()} RE/MAX Titanium. Todos los derechos reservados.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  }
</style>
